#!/bin/sh
# cc (or c++, as nifc++) for NIF libraries in wasi-sdk: compiles for
# wasm32-wasip1, and links a WASI reactor with the erl_nif layer
# (beamos_nif.o) instead of a shared library. Flags for shared libraries
# and dynamic lookup mean nothing here and are left out. C++ has
# exceptions: WebAssembly's new ones (try_table, exnref), as wasi-sdk's
# libc++ has them, since browsers but Firefox refuse a module that mixes
# them with the legacy ones clang still makes by default. setjmp and
# longjmp work in C and C++, on the same exceptions (libsetjmp).
#
# wasi-libc's emulations are on: signal() and raise(), mmap() of memory
# and read-only files, clock() and times(), getpid(). Their headers need
# the _WASI_EMULATED_* defines, given here, and their libraries are
# linked; a library takes only what it uses.
set -e
sjlj="-mllvm -wasm-enable-sjlj -mllvm -wasm-use-legacy-eh=false"
emulated="-D_WASI_EMULATED_SIGNAL -D_WASI_EMULATED_MMAN -D_WASI_EMULATED_PROCESS_CLOCKS -D_WASI_EMULATED_GETPID"
libraries="-lsetjmp -lwasi-emulated-signal -lwasi-emulated-mman -lwasi-emulated-process-clocks -lwasi-emulated-getpid"
case $(basename "$0") in
  *++) compiler=${NIF_CXX:-/opt/wasi-sdk/bin/clang++}; exceptions="-fwasm-exceptions $sjlj"; unwind=-lunwind ;;
  *) compiler=${NIF_CC:-/opt/wasi-sdk/bin/clang}; exceptions="-mexception-handling $sjlj"; unwind= ;;
esac
layer=${NIF_LAYER:-/nif/lib/beamos_nif.o}
link=1
skip=0
for arg do
  shift
  if [ "$skip" = 1 ]; then skip=0; continue; fi
  case $arg in
    -c|-E|-S|-M|-MM) link=0 ;;
    -shared|-fPIC|-fpic|-dynamiclib|-rdynamic|-pthread|-flat_namespace) continue ;;
    -undefined) skip=1; continue ;;
    -Wl,-undefined,*|-Wl,--no-undefined|-Wl,-soname,*|-Wl,-z,defs) continue ;;
  esac
  set -- "$@" "$arg"
done
if [ "$link" = 1 ]; then
  exec "$compiler" $exceptions $emulated -mexec-model=reactor -Wl,-z,stack-size=1048576 "$@" "$layer" $libraries $unwind
fi
exec "$compiler" $exceptions $emulated "$@"
