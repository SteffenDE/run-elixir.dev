diff --git a/brush-interactive/src/blocking.rs b/brush-interactive/src/blocking.rs
new file mode 100644
index 0000000..374b489
--- /dev/null
+++ b/brush-interactive/src/blocking.rs
@@ -0,0 +1,26 @@
+//! Waiting on the shell from the line editor's synchronous callbacks.
+
+use std::future::Future;
+
+/// Runs `future` to its end from synchronous code inside the runtime.
+///
+/// On WASI there is one thread and no blocking pool: what the line editor
+/// waits on (the shell's lock, a completion) is polled in place, which
+/// only ends if nothing else holds what it waits for.
+pub(crate) fn block_on<F: Future>(future: F) -> F::Output {
+    #[cfg(not(target_os = "wasi"))]
+    return tokio::task::block_in_place(|| tokio::runtime::Handle::current().block_on(future));
+
+    #[cfg(target_os = "wasi")]
+    {
+        // Outside tokio's cooperative budget: in place, a budget spent
+        // would never be renewed, and a free lock would never be granted.
+        let mut future = std::pin::pin!(tokio::task::unconstrained(future));
+        let mut context = std::task::Context::from_waker(std::task::Waker::noop());
+        loop {
+            if let std::task::Poll::Ready(output) = future.as_mut().poll(&mut context) {
+                return output;
+            }
+        }
+    }
+}
