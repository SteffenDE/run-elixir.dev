+/// A pipe of the host's: its read end and its write end.
+fn host_pipe_files() -> std::io::Result<(std::fs::File, std::fs::File)> {
+    let mut fds = [0i32; 2];
+    // SAFETY: the host writes two descriptors into `fds`.
