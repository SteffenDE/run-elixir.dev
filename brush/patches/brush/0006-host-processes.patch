+/// What a process writes to a pipe of the host's, fed to a stream of the
+/// shell's (a command substitution's capture).
+pub(crate) struct Feed {
+    from: std::fs::File,
+    to: OpenFile,
+}
+
+impl Feed {
+    fn run(mut self) -> std::io::Result<()> {
+        let mut buf = vec![0u8; 64 * 1024];
+        loop {
+            let n = self.from.read(&mut buf)?;
+            if n == 0 {
+                break;
+            }
+            self.to.write_all(&buf[..n])?;
+        }
+        self.to.flush()
+    }
+}
