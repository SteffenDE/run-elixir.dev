+/// A process of the host's, as the shell waits for it.
+pub mod process {
+    use std::task::Poll;
+
+    /// A process's id: the host's.
+    pub type ProcessId = i32;
+
+    /// How a process ended, as waitpid has it.
+    #[derive(Clone, Copy, Debug)]
+    pub struct ExitStatus(i32);
+
+    impl ExitStatus {
+        /// Its exit status, unless a signal ended it.
+        pub const fn code(&self) -> Option<i32> {
+            if self.0 & 0x7f == 0 { Some((self.0 >> 8) & 0xff) } else { None }
+        }
+
+        /// The signal that ended it, if one did.
+        pub const fn signal(&self) -> Option<i32> {
+            if self.0 & 0x7f == 0 { None } else { Some(self.0 & 0x7f) }
+        }
+    }
+
+    /// What a process left: how it ended (its output went where it was
+    /// sent).
+    pub struct Output {
+        /// How it ended.
+        pub status: ExitStatus,
+    }
+
+    /// A process of the host's, and what feeds streams from its output
+    /// (`feeds`) while the shell waits for it.
+    pub struct Child {
+        pub(super) pid: ProcessId,
+        pub(super) feeds: Vec<super::Feed>,
+    }
+
+    impl Child {
+        /// Returns the process ID of the child process.
+        pub fn id(&self) -> Option<u32> {
+            #[expect(clippy::cast_sign_loss)]
+            Some(self.pid as u32)
+        }
+
+        /// Its output, once it has exited. In the shell's own flow (not a
+        /// task of its, as a job is), waiting suspends the shell, and the
+        /// host's processes run meanwhile. A task waits a little at a time
+        /// and yields: the shell's runtime goes on with its other work.
+        pub async fn wait_with_output(mut self) -> std::io::Result<Output> {
+            let pid = self.pid;
+            for feed in std::mem::take(&mut self.feeds) {
+                feed.run()?;
+            }
+            let in_task = tokio::task::try_id().is_some();
+            std::future::poll_fn(move |context| {
+                let mode = if in_task { 2 } else { 0 };
+                let mut status = 0;
+                // SAFETY: the host writes the status into `status`.
+                let error = unsafe { super::host_wait(pid, &raw mut status, mode) };
+                if error == super::EAGAIN {
+                    context.waker().wake_by_ref();
+                    return Poll::Pending;
+                }
+                if error != 0 {
+                    return Poll::Ready(Err(std::io::Error::from_raw_os_error(error)));
+                }
+                Poll::Ready(Ok(Output { status: ExitStatus(status) }))
+            })
+            .await
+        }
+    }
+
+    /// Not on WASI: the host starts processes (`run_external`).
+    pub(crate) fn spawn(_command: std::process::Command) -> std::io::Result<Child> {
+        Err(std::io::ErrorKind::Unsupported.into())
+    }
+}
