 brush-builtins/src/lib.rs         |   4 +-
 brush-core/src/sys/wasm/mod.rs    |   3 +
 brush-core/src/sys/wasm/signal.rs | 223 ++++++++++++++++++++++++++++++
 6 files changed, 282 insertions(+), 30 deletions(-)
 create mode 100644 brush-core/src/sys/wasm/signal.rs

