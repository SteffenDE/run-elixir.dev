From 4b459e3899bcd573fe2ba9c1a9c48341db310eb9 Mon Sep 17 00:00:00 2001
From: Steffen Deusch <steffen@deusch.me>
Date: Thu, 22 Oct 2026 10:28:23 +0000
Subject: [PATCH] brush-core: a prompt's expansion leaves $?'s change count:
 set -x kept an assignment's status at the last command's

---
 brush-core/src/shell/prompts.rs | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/brush-core/src/shell/prompts.rs b/brush-core/src/shell/prompts.rs
index 4abe4d4..b1841f9 100644
--- a/brush-core/src/shell/prompts.rs
+++ b/brush-core/src/shell/prompts.rs
@@ -54,6 +54,9 @@ impl<SE: extensions::ShellExtensions> Shell<SE> {
         // Save (and later restore) the last exit status.
         let prev_last_result = self.last_exit_status();
         let prev_last_pipeline_statuses = self.last_pipeline_statuses.clone();
+        // And how often it changed: an assignment's status is 0 unless a
+        // command ran while it was expanded, and set -x expands PS4 then.
+        let prev_change_count = self.last_exit_status_change_count;
 
         // Expand it.
         let params = self.default_exec_params();
@@ -62,6 +65,7 @@ impl<SE: extensions::ShellExtensions> Shell<SE> {
         // Restore the last exit status.
         self.last_pipeline_statuses = prev_last_pipeline_statuses;
         self.set_last_exit_status(prev_last_result);
+        self.last_exit_status_change_count = prev_change_count;
 
         // Strip out special characters that readline would typically drop:
         // \001 and \002 (start and end of non-printing sequences).
-- 
2.47.3

