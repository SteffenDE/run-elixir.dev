+//! The Elixir playground's host (run-elixir.dev) on WASI: its programs as
+//! the shell's external commands, and pipes and files that clone.
+//!
+//! WASI has no processes, pipes or `dup`. A command runs to its end when the
+//! shell starts it, so a pipeline's commands run one after another, each
+//! with what the one before wrote: pipes hold what is written until it is
+//! read, and a read of an empty one is its end.
+
+use std::collections::VecDeque;
+use std::io::{Read, Write};
+use std::sync::{Arc, Mutex};
+
+use crate::commands::{CommandArg, ExecutionContext};
+use crate::openfiles::{OpenFile, OpenFiles, Stream};
+use crate::results::{ExecutionResult, ExecutionSpawnResult};
+use crate::{error, extensions};
+
+#[link(wasm_import_module = "playground")]
+unsafe extern "C" {
+    /// Runs a program to its end; the host may suspend the shell meanwhile.
+    /// `request`: NUL-separated program, cwd, argc, args, envc, env.
+    /// `input`: its standard input, unless `flags` has 1 (it has the
+    /// shell's); 2 and 4: its output and errors are the shell's.
+    /// Its exit status, or -1 when there is no such program.
+    fn spawn(
+        request: *const u8,
+        request_len: usize,
+        input: *const u8,
+        input_len: usize,
+        flags: u32,
+    ) -> i32;
+    /// What the last program wrote to `stream` (1 or 2) that was not the
+    /// shell's, up to `max` bytes at a time; 0 at its end.
+    fn output(stream: u32, buf: *mut u8, max: usize) -> usize;
+}
+
+/// One end of a pipe; both ends share the bytes.
+#[derive(Clone, Default)]
+struct Pipe(Arc<Mutex<VecDeque<u8>>>);
+
+impl Read for Pipe {
+    fn read(&mut self, buf: &mut [u8]) -> std::io::Result<usize> {
+        let mut data = self.0.lock().unwrap_or_else(|e| e.into_inner());
+        let n = buf.len().min(data.len());
+        for (slot, byte) in buf.iter_mut().zip(data.drain(..n)) {
+            *slot = byte;
+        }
+        Ok(n)
+    }
+}
+
+impl Write for Pipe {
+    fn write(&mut self, buf: &[u8]) -> std::io::Result<usize> {
+        self.0
+            .lock()
+            .unwrap_or_else(|e| e.into_inner())
+            .extend(buf);
+        Ok(buf.len())
+    }
+
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+
+impl Stream for Pipe {
+    fn clone_box(&self) -> Box<dyn Stream> {
+        Box::new(self.clone())
+    }
+}
+
+/// A pipe: its read end and its write end.
+pub(crate) fn pipe() -> (OpenFile, OpenFile) {
+    let pipe = Pipe::default();
+    (
+        OpenFile::Stream(Box::new(pipe.clone())),
+        OpenFile::Stream(Box::new(pipe)),
+    )
+}
+
+/// A file every clone of which is the same open file (WASI has no `dup`).
+#[derive(Clone)]
+struct SharedFile(Arc<Mutex<std::fs::File>>);
+
+impl Read for SharedFile {
+    fn read(&mut self, buf: &mut [u8]) -> std::io::Result<usize> {
+        self.0.lock().unwrap_or_else(|e| e.into_inner()).read(buf)
+    }
+}
+
+impl Write for SharedFile {
+    fn write(&mut self, buf: &[u8]) -> std::io::Result<usize> {
+        self.0.lock().unwrap_or_else(|e| e.into_inner()).write(buf)
+    }
+
+    fn flush(&mut self) -> std::io::Result<()> {
+        self.0.lock().unwrap_or_else(|e| e.into_inner()).flush()
+    }
+}
+
+impl Stream for SharedFile {
+    fn clone_box(&self) -> Box<dyn Stream> {
+        Box::new(self.clone())
+    }
+}
+
+/// An open file that clones.
+pub(crate) fn file(file: std::fs::File) -> OpenFile {
+    OpenFile::Stream(Box::new(SharedFile(Arc::new(Mutex::new(file)))))
+}
+
+/// Runs an external command through the host, to its end.
+pub(crate) fn run_external(
+    context: &ExecutionContext<'_, impl extensions::ShellExtensions>,
+    executable_path: &str,
+    args: &[CommandArg],
+) -> Result<ExecutionSpawnResult, error::Error> {
+    let args = args
+        .iter()
+        .filter_map(|arg| match arg {
+            CommandArg::String(s) => Some(s.as_str()),
+            CommandArg::Assignment(_) => None,
+        })
+        .collect::<Vec<_>>();
+    let mut env = context
+        .shell
+        .env()
+        .iter_exported()
+        .filter(|(_, v)| v.value().is_set())
+        .map(|(k, v)| format!("{k}={}", v.value().to_cow_str(context.shell)))
+        .collect::<Vec<_>>();
+    env.push(format!("_={executable_path}"));
+
+    let mut request = Vec::new();
+    let mut field = |text: &str| {
+        request.extend_from_slice(text.as_bytes());
+        request.push(0);
+    };
+    field(executable_path);
+    field(&context.shell.working_dir().to_string_lossy());
+    field(&args.len().to_string());
+    for arg in &args {
+        field(arg);
+    }
+    field(&env.len().to_string());
+    for var in &env {
+        field(var);
+    }
+
+    let mut flags = 0;
+    let mut input = Vec::new();
+    match context.try_fd(OpenFiles::STDIN_FD) {
+        Some(OpenFile::Stdin(_)) | None => flags |= 1,
+        Some(mut file) => {
+            file.read_to_end(&mut input)?;
+        }
+    }
+    let stdout = match context.try_fd(OpenFiles::STDOUT_FD) {
+        Some(OpenFile::Stdout(_)) | None => {
+            flags |= 2;
+            None
+        }
+        Some(file) => Some(file),
+    };
+    let stderr = match context.try_fd(OpenFiles::STDERR_FD) {
+        Some(OpenFile::Stderr(_)) | None => {
+            flags |= 4;
+            None
+        }
+        Some(file) => Some(file),
+    };
+
+    // SAFETY: the pointers and lengths are of live buffers the host only
+    // reads during the call.
+    let status = unsafe {
+        spawn(
+            request.as_ptr(),
+            request.len(),
+            input.as_ptr(),
+            input.len(),
+            flags,
+        )
+    };
+    if status < 0 {
+        return Err(error::ErrorKind::CommandNotFound(context.command_name.clone()).into());
+    }
+
+    for (stream, file) in [(1, stdout), (2, stderr)] {
+        let Some(mut file) = file else { continue };
+        let mut buf = vec![0u8; 64 * 1024];
+        loop {
+            // SAFETY: the host writes at most `buf.len()` bytes into `buf`.
+            let n = unsafe { output(stream, buf.as_mut_ptr(), buf.len()) };
+            if n == 0 {
+                break;
+            }
+            file.write_all(&buf[..n])?;
+        }
+        file.flush()?;
+    }
+
+    #[expect(clippy::cast_sign_loss, clippy::cast_possible_truncation)]
+    Ok(ExecutionSpawnResult::Completed(ExecutionResult::new(
+        (status & 0xff) as u8,
+    )))
+}
