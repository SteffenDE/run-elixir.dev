+//! WASI: the terminal's input from the host (`terminal/sys/wasi.rs`'s
+//! `read`), parsed as on Unix.
+
+use std::{collections::VecDeque, io, time::Duration};
+
+#[cfg(feature = "event-stream")]
+use crate::event::sys::Waker;
+use crate::event::timeout::PollTimeout;
+use crate::event::{source::EventSource, sys::unix::parse::parse_event, Event, InternalEvent};
+use crate::terminal::sys::wasi::read;
+
+const BUFFER_SIZE: usize = 1_024;
+
+pub(crate) struct WasiInternalEventSource {
+    parser: Parser,
+    buffer: [u8; BUFFER_SIZE],
+}
+
+impl WasiInternalEventSource {
+    pub fn new() -> io::Result<Self> {
+        Ok(WasiInternalEventSource {
+            parser: Parser::default(),
+            buffer: [0u8; BUFFER_SIZE],
+        })
+    }
+}
+
+impl EventSource for WasiInternalEventSource {
+    fn try_read(&mut self, timeout: Option<Duration>) -> io::Result<Option<InternalEvent>> {
+        let timeout = PollTimeout::new(timeout);
+        loop {
+            if let Some(event) = self.parser.next() {
+                return Ok(Some(event));
+            }
+            let ms = match timeout.leftover() {
+                None => -1,
+                Some(left) if left.is_zero() => return Ok(None),
+                Some(left) => i32::try_from(left.as_millis()).unwrap_or(i32::MAX).max(1),
+            };
+            // SAFETY: the host writes at most `BUFFER_SIZE` bytes into the buffer.
+            let n = unsafe { read(self.buffer.as_mut_ptr(), BUFFER_SIZE, ms) };
+            if n < 0 {
+                let (columns, rows) = crate::terminal::size()?;
+                return Ok(Some(InternalEvent::Event(Event::Resize(columns, rows))));
+            }
+            let n = usize::try_from(n).unwrap_or(0);
+            if n == 0 && timeout.elapsed() {
+                return Ok(None);
+            }
+            self.parser.advance(&self.buffer[..n], n == BUFFER_SIZE);
+        }
+    }
+
+    #[cfg(feature = "event-stream")]
+    fn waker(&self) -> Waker {
+        unimplemented!("no event stream on WASI")
+    }
+}
+
+// As Unix's (`event/source/unix/tty.rs`).
+#[derive(Debug)]
+struct Parser {
+    buffer: Vec<u8>,
+    internal_events: VecDeque<InternalEvent>,
+}
+
+impl Default for Parser {
+    fn default() -> Self {
+        Parser {
+            buffer: Vec::with_capacity(256),
+            internal_events: VecDeque::with_capacity(128),
+        }
+    }
+}
+
+impl Parser {
+    fn advance(&mut self, buffer: &[u8], more: bool) {
+        for (idx, byte) in buffer.iter().enumerate() {
+            let more = idx + 1 < buffer.len() || more;
+            self.buffer.push(*byte);
+            match parse_event(&self.buffer, more) {
+                Ok(Some(ie)) => {
+                    self.internal_events.push_back(ie);
+                    self.buffer.clear();
+                }
+                Ok(None) => {}
+                Err(_) => self.buffer.clear(),
+            }
+        }
+    }
+}
+
+impl Iterator for Parser {
+    type Item = InternalEvent;
+
+    fn next(&mut self) -> Option<Self::Item> {
+        self.internal_events.pop_front()
+    }
+}
