@@ -0,0 +1,69 @@
+//! WASI: the terminal is the host's. It sets raw mode and tells the size,
+//! and the event source reads its input (`event/source/wasi.rs`), through
+//! the `crossterm` imports.
+
+use std::io;
+use std::sync::atomic::{AtomicBool, Ordering};
+
+use crate::terminal::WindowSize;
+
+#[link(wasm_import_module = "crossterm")]
+unsafe extern "C" {
+    /// Sets raw mode (1) or the host's line editing (0); 0 when done.
+    fn raw_mode(on: i32) -> i32;
+    /// The terminal's columns and rows; 0 when known.
+    #[link_name = "size"]
+    fn host_size(columns: *mut u16, rows: *mut u16) -> i32;
+    /// Up to `max` bytes of the terminal's input into `buf`, waiting up to
+    /// `timeout_ms` (-1: until some come). Their count; 0 when none came,
+    /// -1 when the terminal was resized meanwhile.
+    pub(crate) fn read(buf: *mut u8, max: usize, timeout_ms: i32) -> i32;
+}
+
+static RAW: AtomicBool = AtomicBool::new(false);
+
+pub(crate) fn is_raw_mode_enabled() -> bool {
+    RAW.load(Ordering::SeqCst)
+}
+
+fn set_raw(on: bool) -> io::Result<()> {
+    // SAFETY: an import without pointers.
+    if unsafe { raw_mode(i32::from(on)) } != 0 {
+        return Err(io::Error::other("the terminal cannot change its mode"));
+    }
+    RAW.store(on, Ordering::SeqCst);
+    Ok(())
+}
+
+pub(crate) fn enable_raw_mode() -> io::Result<()> {
+    set_raw(true)
+}
+
+pub(crate) fn disable_raw_mode() -> io::Result<()> {
+    set_raw(false)
+}
+
+pub(crate) fn size() -> io::Result<(u16, u16)> {
+    let (mut columns, mut rows) = (0u16, 0u16);
+    // SAFETY: the host writes one u16 at each of the two pointers.
+    if unsafe { host_size(&mut columns, &mut rows) } != 0 {
+        return Err(io::Error::other("the terminal's size is not known"));
+    }
+    Ok((columns, rows))
+}
+
+pub(crate) fn window_size() -> io::Result<WindowSize> {
+    let (columns, rows) = size()?;
+    Ok(WindowSize {
+        rows,
+        columns,
+        width: 0,
+        height: 0,
+    })
+}
+
+/// The host's terminal does not take the keyboard enhancement protocol.
+#[cfg(feature = "events")]
+pub fn supports_keyboard_enhancement() -> io::Result<bool> {
+    Ok(false)
+}
