    "@remixicon/react": "4.9.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "buffer": "6.0.3",
    "dexie": "4.4.6",
    "esbuild-wasm": "0.25.4",
    "events": "3.3.0",
    "isomorphic-git": "1.42.3",
    "phoenix": "1.8.15",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "4.14.4",
    "readable-stream": "4.7.0",
    "semver": "7.7.3",
