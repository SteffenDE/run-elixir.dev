{
  "name": "elixir-playground",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test",
    "format": "oxfmt src test",
    "format:check": "oxfmt --check src test",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@elixir-playground/api": "*",
    "@elixir-playground/pglite": "*",
    "@elixir-playground/runtime": "*",
    "@pierre/diffs": "1.6.1",
    "@pierre/trees": "1.0.0-beta.6",
    "@remixicon/react": "4.9.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "dexie": "4.4.6",
    "phoenix": "1.8.15",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "4.14.4",
    "slice-ansi": "9.0.1",
    "string-width": "8.3.0",
    "strip-ansi": "7.2.0",
    "wrap-ansi": "10.0.2",
    "yjs": "13.6.27",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.0",
    "@types/phoenix": "1.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.2"
  }
}
