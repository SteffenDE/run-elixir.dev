{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "src",
    "test",
    "../packages/*/src/**/*.d.ts",
    "vite.config.ts",
    "vite.api.config.ts",
    "../vite-licenses.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ]
}
