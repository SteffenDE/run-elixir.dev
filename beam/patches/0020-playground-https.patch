+%%--------------------------------------------------------------------
+%% The Elixir Playground (playground/beam, patch 0020): its node cannot
+%% open connections out of the browser, whose page makes HTTPS requests
+%% with fetch instead, or connects through the user's tailnet. With
+%% PLAYGROUND_HTTPS_GATEWAY, connect/4 connects to that port of the
+%% playground's network, names the host and port in a first line, and
+%% the page's first line says how it goes on: "fetch", plain HTTP, which
+%% the page answers (a gen_tcp socket is returned, which the functions
+%% clients use on a socket take and leave to gen_tcp and inet: its
+%% messages are tcp's); "tcp", the host itself, over which the node does
+%% TLS as connect/4 would; or "error Reason".
+%%--------------------------------------------------------------------
+playground_connect(Gateway, Host, Port, Options, Timeout) ->
+    Name = case Host of
+               _ when is_tuple(Host) -> inet:ntoa(Host);
+               _ when is_atom(Host) -> atom_to_list(Host);
+               _ -> Host
+           end,
+    case gen_tcp:connect({127,0,0,1}, Gateway, [binary, {active, false}, {packet, line}],
+                         Timeout) of
+        {ok, Socket} ->
+            ok = gen_tcp:send(Socket, [Name, $:, integer_to_list(Port), $\n]),
+            case gen_tcp:recv(Socket, 0, Timeout) of
+                {ok, <<"fetch\n">>} ->
+                    playground_plain(Socket, Options);
+                {ok, <<"tcp\n">>} ->
+                    playground_tls(Socket, Host, Name, Options, Timeout);
+                {ok, <<"error ", Reason/binary>>} ->
+                    gen_tcp:close(Socket),
+                    {error, binary_to_atom(string:trim(Reason))};
+                {ok, _} ->
+                    gen_tcp:close(Socket),
+                    {error, einval};
+                {error, _} = Error ->
+                    gen_tcp:close(Socket),
+                    Error
+            end;
+        Error ->
+            Error
+    end.
+
+playground_plain(Socket, Options) ->
+    case inet:setopts(Socket, [list, {packet, raw} | playground_options(Options)]) of
+        ok -> {ok, Socket};
+        Error -> gen_tcp:close(Socket), Error
+    end.
+
+%% TLS over the connection, as connect/4 does it: the host's name for SNI
+%% and the certificate's check, unless the options name one.
+playground_tls(Socket, Host, Name, Options, Timeout) ->
+    ok = inet:setopts(Socket, [{packet, raw}]),
+    Named = lists:keymember(server_name_indication, 1, Options) orelse is_tuple(Host),
+    Sni = case Named of
+              true -> [];
+              false -> [{server_name_indication, Name}]
+          end,
+    case connect(Socket, Sni ++ Options, Timeout) of
+        {ok, _} = Ok -> Ok;
+        Error -> gen_tcp:close(Socket), Error
+    end.
+
+playground_options(Options) ->
+    [Option || Option <- Options, playground_option(Option)].
+
+playground_option(binary) -> true;
+playground_option(list) -> true;
+playground_option({Name, _}) ->
+    lists:member(Name, [mode, active, packet, packet_size, header, nodelay,
+                        keepalive, send_timeout, send_timeout_close]);
+playground_option(_) -> false.
