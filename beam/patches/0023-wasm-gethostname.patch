       HostName :: string(),
       Reason   :: term().
 
+%% Without esock (no prim_net NIF), as in the playground, every node is
+%% on the one host, localhost: inet:gethostname/0, which global asks
+%% whenever a node connects, and -sname without a host.
 gethostname() ->
-    nif_gethostname().
+    try nif_gethostname()
+    catch error:notsup -> {ok, "localhost"}
+    end.
 
 
