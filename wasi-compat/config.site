# Answers for a tool's configure (CONFIG_SITE, before the tool's own):
# what wasi-posix.h declares and stubs.c defines is there and declared.
# configure's checks see neither header (the build appends it to
# config.h), so they would take each for missing and have gnulib replace
# it, or not use it at all. Not fork and exec, which stubs.c has fail:
# without them a tool starts programs by popen and system (diff3's diff,
# sdiff's editor, diff --paginate's pr).
ac_cv_func_fork=no
ac_cv_func_fork_works=no
ac_cv_func_vfork=no
ac_cv_func_vfork_works=no
for ac_func in getuid geteuid getgid getegid getppid getpgid getpgrp \
    setsid tcgetpgrp umask chmod fchmod chown fchown dup dup2 pipe kill alarm getdtablesize getpass \
    mkdtemp mkstemp popen pclose system sigaction sigemptyset sigfillset sigaddset sigdelset sigismember \
    sigprocmask tzset; do
  eval "ac_cv_func_$ac_func=yes"
  eval "ac_cv_have_decl_$ac_func=yes"
done
# Its sigset_t and struct sigaction (wasi-posix.h's), not wasi-libc's.
gl_cv_type_sigset_t=yes
ac_cv_type_sigset_t=yes
ac_cv_member_struct_sigaction_sa_sigaction=no
# sys/wait.h's macros are wasi-compat/include's; configure's check also
# calls wait(), which is not (the host waits for a pid).
ac_cv_header_sys_wait_h=yes
