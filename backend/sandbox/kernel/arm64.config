# QEMU virt and Firecracker ARM machines boot from a device tree.
CONFIG_ARCH_VIRT=y
CONFIG_ARM_AMBA=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM_PSCI_FW=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_OF=y

# QEMU's PL011 console and Firecracker's 8250-compatible serial console.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y

# PCI is optional in Firecracker and available on QEMU's virt machine.
CONFIG_PCI=y
CONFIG_PCI_HOST_COMMON=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_PCI_MSI=y

# Firecracker recommends PL031 for ARM guest timekeeping.
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PL031=y
