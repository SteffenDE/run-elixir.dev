# Drivers are built in, the VM boots without an initramfs or modules.
CONFIG_MODULES=n
CONFIG_CC_OPTIMIZE_FOR_SIZE=y

# Userspace and the BEAM runtime.
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_COREDUMP=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_FUTEX=y
CONFIG_INOTIFY_USER=y
CONFIG_MEMFD_CREATE=y
CONFIG_MULTIUSER=y
CONFIG_POSIX_TIMERS=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y

# The root disk and the virtual filesystems mounted by the guest init.
CONFIG_BLOCK=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EXT4_FS=y
CONFIG_PROC_FS=y
CONFIG_SHMEM=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_UNIX98_PTYS=y

CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_VIRTIO_NET=y

# Firecracker has no virtio-serial, so the guest reaches the host over vsock,
# and tunnels its network through a TAP device, see sandbox-vsock.
CONFIG_TUN=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y

# Virtio devices of QEMU and Firecracker, over both MMIO and PCI.
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_PCI=y

# strace --seccomp-bpf, which only stops a traced job for the syscalls it
# records.
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

CONFIG_PRINTK=y
CONFIG_TTY=y

CONFIG_BT=n
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_KERNEL=n
CONFIG_DRM=n
CONFIG_FTRACE=n
CONFIG_KPROBES=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_PERF_EVENTS=n
CONFIG_SOUND=n
CONFIG_USB_SUPPORT=n
CONFIG_WIRELESS=n
CONFIG_WLAN=n
