# Copy to .env and fill in, for docker-compose.yml.

# The host name the admin reaches the backend at.
PHX_HOST=run-elixir.steffend.me

# mix phx.gen.secret, or: openssl rand -base64 48
SECRET_KEY_BASE=

POSTGRES_PASSWORD=

# A GitHub OAuth app, with the callback https://<PHX_HOST>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The GitHub logins let into /admin and /api/admin, separated by commas
# (SteffenDE when empty).
ADMIN_GITHUB_LOGINS=

# The group owning /dev/kvm on this machine: getent group kvm | cut -d: -f3
KVM_GID=

# Where the database (db/), the app's data (playground/) and the VM's
# artifacts (sandbox/) are, ./data when empty: a directory outside the
# checkout keeps them when it is cloned anew.
DATA_DIR=
# Where sandbox/build put the VM's artifacts, DATA_DIR/sandbox when empty.
SANDBOX_DIR=
# Build VMs' vCPUs and memory, 2 and 4096 when empty.
NIF_VM_CPUS=
NIF_VM_MEMORY_MIB=

# The port the app listens on, on 127.0.0.1 (4000 when empty).
PORT=

# The OpenAI API key the agent that writes build templates uses. Without
# it, packages without a template fail.
OPENAI_API_KEY=
# A ReqLLM model spec, openai:gpt-6-luna when empty.
NIF_AGENT_MODEL=
# What agent sessions may spend in a day, 20 when empty.
NIF_DAILY_BUDGET_USD=

# Web Push, for notifications about failed builds and new templates:
# mix playground.gen.vapid. Replacing the key orphans every subscription.
# The subject is how push services reach whoever runs the backend, a
# mailto: or https: URL, https://<PHX_HOST> when empty.
PLAYGROUND_VAPID_PRIVATE_KEY=
PLAYGROUND_VAPID_SUBJECT=
