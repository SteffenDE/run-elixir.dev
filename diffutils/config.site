# diffutils' configure for wasm32-wasip1 (after wasi-compat/config.site),
# which cannot run what it builds: gnulib's regex and getopt, GNU's own,
# rather than wasi-libc's (musl's), so that diff -I and -F match and its
# options parse as Linux's do.
gl_cv_func_re_compile_pattern_working=no
gl_cv_func_getopt_gnu=no
# Checks with no answer of their own when cross-compiling: wasi-libc's.
gl_cv_func_strcasecmp_works=yes
