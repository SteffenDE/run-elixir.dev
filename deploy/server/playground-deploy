#!/bin/bash
# The server's side of the playground's deploys (deploy.md). As the
# forced command of the deploy key (authorized_keys: command=…,restrict)
# it takes, from SSH_ORIGINAL_COMMAND:
#
#   rsync --server …        an upload, through rrsync, into releases/ only
#   prepare RID BUILD RUNTIME  releases/RID.partial, seeded from the live release
#   activate RID            check it, make it live, check the site, purge
#   rollback                the release before the live one, live again
#   status                  the live release, its build and runtime
#
# Run by hand, the same as arguments. Its configuration is
# /etc/playground-deploy.env (PLAYGROUND_DEPLOY_CONFIG):
#
#   SITE=/srv/playground/run-elixir   releases/ and current, Caddy's root
#   DOMAIN=run-elixir.dev             checked in playground.json and served
#   USERCONTENT=…                     the usercontent domain (docs/frames.md):
#                                     checked in playground.json, its hosts
#                                     served for the apex to frame
#   CHECK_RESOLVE=127.0.0.1           where the check reaches the origin
#                                     (empty: no check)
#   KEEP_RELEASES=5 KEEP_BUILDS=3     releases kept; builds (b/ID) and
#                                     runtimes (r/RID) carried
#   CF_ZONE_ID=… CF_API_TOKEN=…       Cloudflare, to purge the apex's pages (a
#                                     token with Zone → Cache Purge only);
#                                     optional: the pages are no-cache
#                                     (docs/deploy.md, Cloudflare)
set -euo pipefail
CONFIG=${PLAYGROUND_DEPLOY_CONFIG:-/etc/playground-deploy.env}
# shellcheck source=/dev/null
[ -r "$CONFIG" ] && . "$CONFIG"
: "${SITE:?SITE is not configured ($CONFIG)}"
DOMAIN=${DOMAIN:-}
USERCONTENT=${USERCONTENT:-}
CHECK_RESOLVE=${CHECK_RESOLVE-127.0.0.1}
KEEP_RELEASES=${KEEP_RELEASES:-5}
KEEP_BUILDS=${KEEP_BUILDS:-3}
RELEASES=$SITE/releases
# The pages and what keeps its name; everything else is under b/ID (the
# runtime's JavaScript) and r/RID (the BEAM, fs/, nif/).
PAGES=(index.html preview.html relay.html exec.html storage.html sw.js playground.json embed.html embed.js)

die() {
  echo "playground-deploy: $*" >&2
  exit 1
}

# What a release's (or a page's) <meta name="playground-$2"> names.
meta_of() {
  sed -n "s/.*<meta name=\"playground-$2\" content=\"\([0-9a-f]*\)\".*/\1/p" "$1" 2>/dev/null | head -n 1
}
build_of() { meta_of "$1/index.html" build; }
runtime_of() { meta_of "$1/index.html" runtime; }

valid_rid() { [[ $1 =~ ^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{7,40}$ ]] || die "not a release: $1"; }
valid_build() { [[ $1 =~ ^[0-9a-f]{16}$ ]] || die "not a build: $1"; }

# Releases, newest first.
releases() {
  find "$RELEASES" -mindepth 1 -maxdepth 1 -type d ! -name '*.partial' -printf '%f\n' | sort -r
}

live() { readlink "$SITE/current" 2>/dev/null | sed 's|^releases/||'; }

# Atomically: current names releases/$1.
swap() {
  ln -sfn "releases/$1" "$SITE/current.new"
  mv -T "$SITE/current.new" "$SITE/current"
}

prepare() {
  local rid=$1 build=$2 runtime=$3 old partial
  valid_rid "$rid"
  valid_build "$build"
  valid_build "$runtime"
  partial=$RELEASES/$rid.partial
  rm -rf "$partial"
  mkdir -p "$partial"
  if [ -d "$SITE/current/" ]; then
    cp -al "$SITE/current/." "$partial/"
    old=$(build_of "$SITE/current")
    if [ -n "$old" ] && [ -d "$partial/b/$old" ] && [ ! -e "$partial/b/$build" ]; then
      cp -al "$partial/b/$old" "$partial/b/$build"
    fi
    # A runtime the live release has already is there as it is; a new one
    # starts from the live one's files, which rsync then updates.
    old=$(runtime_of "$SITE/current")
    if [ -n "$old" ] && [ -d "$partial/r/$old" ] && [ ! -e "$partial/r/$runtime" ]; then
      cp -al "$partial/r/$old" "$partial/r/$runtime"
    fi
  fi
}

# The site as served: the pages' isolation headers, this build named, its
# runtime's WebAssembly and immutable, the pages and the service worker
# revalidated, and the usercontent domain's frame and Node.js worker.
check() {
  local build=$1 runtime=$2 base page headers
  [ -n "$DOMAIN" ] && [ -n "$CHECK_RESOLVE" ] || return 0
  base=https://$DOMAIN
  local curl=(curl -fsS --max-time 30 --resolve "$DOMAIN:443:$CHECK_RESOLVE")
  page=$(mktemp)
  trap 'rm -f "$page"' RETURN
  headers=$("${curl[@]}" -D - -o "$page" "$base/") || { echo "check: / failed" >&2; return 1; }
  grep -qi '^cross-origin-opener-policy: same-origin' <<<"$headers" || { echo "check: no COOP" >&2; return 1; }
  grep -qi '^cross-origin-embedder-policy: require-corp' <<<"$headers" || { echo "check: no COEP" >&2; return 1; }
  if ! grep -q "content=\"$build\"" "$page"; then
    echo "check: / is build $(meta_of "$page" build | grep . || echo '(none named)'), not $build: is Caddy's root $SITE/current?" >&2
    return 1
  fi
  if [ -n "$runtime" ]; then
    "${curl[@]}" -o /dev/null -w '%{content_type}\n' "$base/r/$runtime/beam.wasm" | grep -q '^application/wasm' ||
      { echo "check: r/$runtime/beam.wasm is not served as WebAssembly" >&2; return 1; }
  fi
  "${curl[@]}" -o /dev/null -D - "$base/sw.js" | grep -qi '^cache-control: no-cache' ||
    { echo "check: sw.js is not no-cache" >&2; return 1; }
  # The pages revalidate (nothing needs purging); what is versioned does not.
  grep -qi '^cache-control: no-cache' <<<"$headers" || { echo "check: / is not no-cache" >&2; return 1; }
  if [ -n "$runtime" ]; then
    "${curl[@]}" -o /dev/null -D - "$base/r/$runtime/beam.wasm" | grep -qi '^cache-control:.*immutable' ||
      { echo "check: r/$runtime/beam.wasm is not immutable" >&2; return 1; }
  fi
  # embed.html, framed by the embedders the site names under their COEP,
  # and embed.js, which their pages import (docs/embed.md).
  headers=$("${curl[@]}" -D - -o /dev/null "$base/embed.html") || { echo "check: /embed.html failed" >&2; return 1; }
  grep -qi '^cross-origin-resource-policy: cross-origin' <<<"$headers" ||
    { echo "check: /embed.html is not CORP cross-origin (docs/embed.md)" >&2; return 1; }
  grep -qi '^content-security-policy: frame-ancestors ' <<<"$headers" ||
    { echo "check: /embed.html names no frame-ancestors (docs/embed.md)" >&2; return 1; }
  headers=$("${curl[@]}" -D - -o /dev/null "$base/embed.js") || { echo "check: /embed.js failed" >&2; return 1; }
  grep -qi '^access-control-allow-origin: \*' <<<"$headers" ||
    { echo "check: /embed.js has no CORS (docs/embed.md)" >&2; return 1; }
  # A project's exec frame on the usercontent domain: framed by the apex,
  # from another site.
  if [ -n "$USERCONTENT" ]; then
    local exec_host=e-aaaaaaaaaa.$USERCONTENT
    headers=$(curl -fsS --max-time 30 --resolve "$exec_host:443:$CHECK_RESOLVE" -D - -o /dev/null \
      "https://$exec_host/exec.html") || { echo "check: $exec_host/exec.html failed" >&2; return 1; }
    grep -qi '^cross-origin-embedder-policy: require-corp' <<<"$headers" ||
      { echo "check: no COEP on $exec_host" >&2; return 1; }
    grep -qi '^cross-origin-resource-policy: cross-origin' <<<"$headers" ||
      { echo "check: $exec_host is not CORP cross-origin" >&2; return 1; }
    grep -qi '^cache-control: no-cache' <<<"$headers" ||
      { echo "check: $exec_host/exec.html is not no-cache" >&2; return 1; }
    # A Node.js process's worker: its policy, the site's files alone.
    headers=$(curl -fsS --max-time 30 --resolve "$exec_host:443:$CHECK_RESOLVE" -D - -o /dev/null \
      "https://$exec_host/b/$build/nodejs.js") || { echo "check: $exec_host/b/$build/nodejs.js failed" >&2; return 1; }
    grep -qi "^content-security-policy: default-src 'none';.*worker-src https://$exec_host/b/$build/nodejs.js .*connect-src https://$exec_host/r/ " <<<"$headers" ||
      { echo "check: $exec_host/b/$build/nodejs.js has no Content-Security-Policy (docs/deploy.md)" >&2; return 1; }
  fi
}

# The pages keep their names: drop the edge's copies (b/ and _playground/
# are new names each build). Project origins' pages are not cached by
# Cloudflare by default (HTML, JSON; sw.js is no-cache).
purge() {
  [ -n "${CF_ZONE_ID:-}" ] && [ -n "${CF_API_TOKEN:-}" ] && [ -n "$DOMAIN" ] || return 0
  local files=("\"https://$DOMAIN/\"") page answer
  for page in "${PAGES[@]}"; do files+=("\"https://$DOMAIN/$page\""); done
  answer=$(curl -sS --max-time 30 -X POST "https://api.cloudflare.com/client/v4/zones/$CF_ZONE_ID/purge_cache" \
    -H "Authorization: Bearer $CF_API_TOKEN" -H 'Content-Type: application/json' \
    --data "{\"files\":[$(IFS=,; echo "${files[*]}")]}") || true
  grep -q '"success": *true' <<<"$answer" || echo "playground-deploy: warning: Cloudflare purge failed: $answer" >&2
}

activate() {
  local rid=$1 partial release build runtime previous keep name page top
  valid_rid "$rid"
  partial=$RELEASES/$rid.partial
  release=$RELEASES/$rid
  [ -d "$partial" ] || die "no upload for $rid"
  build=$(build_of "$partial")
  [ -n "$build" ] || die "$rid: index.html names no build"
  runtime=$(runtime_of "$partial")
  [ -n "$runtime" ] || die "$rid: index.html names no runtime"
  for page in "${PAGES[@]}" "b/$build/worker.js" "r/$runtime/beam.wasm" "r/$runtime/fs/manifest.json" \
              "r/$runtime/fs/version"; do
    [ -s "$partial/$page" ] || die "$rid: $page is missing"
  done
  if [ -n "$DOMAIN" ]; then
    grep -q "\"domain\": *\"$DOMAIN\"" "$partial/playground.json" || die "$rid: playground.json does not name $DOMAIN"
  fi
  if [ -n "$USERCONTENT" ]; then
    grep -q "\"usercontent\": *\"$USERCONTENT\"" "$partial/playground.json" ||
      die "$rid: playground.json does not name $USERCONTENT"
  fi
  # The builds and runtimes of the newest releases, this one's first, stay.
  for top in b:build r:runtime; do
    keep=$({ meta_of "$partial/index.html" "${top#*:}"
             for name in $(releases); do meta_of "$RELEASES/$name/index.html" "${top#*:}"; done
           } | awk 'NF && !seen[$0]++' | head -n "$KEEP_BUILDS")
    for name in "$partial/${top%%:*}"/*/; do
      [ -d "$name" ] || continue
      name=$(basename "$name")
      grep -qx "$name" <<<"$keep" || rm -rf "${partial:?}/${top%%:*}/$name"
    done
  done
  mv "$partial" "$release"
  previous=$(live || true)
  swap "$rid"
  if ! check "$build" "$runtime"; then
    if [ -n "$previous" ]; then
      swap "$previous"
    else
      rm "$SITE/current"
    fi
    die "$rid failed its check; live again: ${previous:-nothing}"
  fi
  purge
  # Old releases go, and failed uploads; never the live one.
  for name in $(releases | tail -n +"$((KEEP_RELEASES + 1))"); do
    [ "$name" = "$rid" ] || rm -rf "${RELEASES:?}/$name"
  done
  find "$RELEASES" -mindepth 1 -maxdepth 1 -type d -name '*.partial' -mmin +60 -exec rm -rf {} +
  echo "live: $rid (build $build, runtime $runtime)"
}

rollback() {
  local current before
  current=$(live) || die "nothing is live"
  before=$(releases | grep -A1 -x "$current" | sed -n 2p)
  [ -n "$before" ] || die "no release before $current"
  swap "$before"
  check "$(build_of "$RELEASES/$before")" "$(runtime_of "$RELEASES/$before")" || echo "playground-deploy: warning: $before failed its check" >&2
  purge
  echo "live: $before (build $(build_of "$RELEASES/$before"))"
}

if [ -n "${SSH_ORIGINAL_COMMAND:-}" ]; then
  case $SSH_ORIGINAL_COMMAND in
    "rsync --server "*)
      mkdir -p "$RELEASES"
      exec rrsync -wo "$RELEASES"
      ;;
  esac
  read -r -a words <<<"$SSH_ORIGINAL_COMMAND"
else
  words=("$@")
fi
mkdir -p "$RELEASES"
exec 9>"$SITE/.deploy.lock"
flock -w 600 9 || die "another deploy holds the lock"
case "${words[0]:-} ${#words[@]}" in
  "prepare 4") prepare "${words[1]}" "${words[2]}" "${words[3]}" ;;
  "activate 2") activate "${words[1]}" ;;
  "rollback 1") rollback ;;
  "status 1") echo "live: $(live) (build $(build_of "$SITE/current"), runtime $(runtime_of "$SITE/current"))" ;;
  *) die "unknown command: ${words[*]:-}" ;;
esac
