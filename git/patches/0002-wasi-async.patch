--- a/run-command.c
+++ b/run-command.c
@@ -1192,6 +1192,48 @@ int git_atexit(void (*handler)(void))
 }
 #define atexit git_atexit
 
+#ifdef __wasi__
+/*
+ * WASI: an async function runs beside git as a coroutine of the host's,
+ * on a stack of its own (wasi_async_start, wasi-compat/stubs.c). It shares
+ * git's descriptors and memory as a thread would; the host says which
+ * runs, and ends one that dies.
+ */
+int in_async(void)
+{
+	return wasi_async_current() != NULL;
+}
+
+static void NORETURN async_exit(int code)
+{
+	wasi_async_exit(code);
+}
+
+static NORETURN void die_async(const char *err, va_list params)
+{
+	report_fn die_message_fn = get_die_message_routine();
+
+	die_message_fn(err, params);
+
+	if (in_async()) {
+		struct async *async = wasi_async_current();
+		if (async->proc_in >= 0)
+			close(async->proc_in);
+		if (async->proc_out >= 0)
+			close(async->proc_out);
+		async_exit(128);
+	}
+
+	exit(128);
+}
+
+/* What the host's coroutine runs: the exit status, as a forked one's. */
+__attribute__((export_name("wasi_run_async")))
+int wasi_run_async(struct async *async)
+{
+	return !!async->proc(async->proc_in, async->proc_out, async->data);
+}
+#else
 static int process_is_async;
 int in_async(void)
 {
@@ -1202,6 +1244,7 @@ static void NORETURN async_exit(int code)
 {
 	exit(code);
 }
+#endif
 
 #endif
 
@@ -1260,7 +1303,22 @@ int start_async(struct async *async)
 	else
 		proc_out = -1;
 
-#ifdef NO_PTHREADS
+#if defined(__wasi__)
+	{
+		static int started;
+		if (!started) {
+			started = 1;
+			set_die_routine(die_async);
+		}
+	}
+	async->proc_in = proc_in;
+	async->proc_out = proc_out;
+	async->pid = wasi_async_start(async, &async->stack);
+	if (async->pid < 0) {
+		error_errno("cannot start async");
+		goto error;
+	}
+#elif defined(NO_PTHREADS)
 	/* Flush stdio before fork() to avoid cloning buffers */
 	fflush(NULL);
 
@@ -1339,6 +1397,10 @@ int finish_async(struct async *async)
 	int ret = wait_or_whine(async->pid, "child process", 0);
 
 	invalidate_lstat_cache();
+#ifdef __wasi__
+	free(async->stack);
+	async->stack = NULL;
+#endif
 
 	return ret;
 #else
@@ -1354,7 +1416,7 @@ int finish_async(struct async *async)
 
 int async_with_fork(void)
 {
-#ifdef NO_PTHREADS
